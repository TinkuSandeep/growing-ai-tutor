# dev | prod
APP_ENV=dev
APP_NAME=Growing AI Tutor
APP_PASSWORD=change-me-before-deployment
SESSION_SECRET=replace-with-a-long-random-string
SESSION_HTTPS_ONLY=false

# Local SQLite by default. For PostgreSQL use:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./data/tutor.db

# Optional. The app still works without AI and uses deterministic fallback teaching.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
